# Copy to .env to override the local defaults used by docker-compose.yml.
# These are LOCAL DEMO credentials. Never reuse them anywhere reachable from a network.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# `make kpis` assumes user/db "ved"; change the Makefile's PSQL line if you rename them.
POSTGRES_USER=ved
POSTGRES_PASSWORD=ved
POSTGRES_DB=ved

# Ingest API keys as "partner:key,partner:key". The simulator sends as PARTNER_API_KEY.
API_KEYS=partner-a:dev-key-a
PARTNER_API_KEY=dev-key-a

# Weekly VED files to replay (chronologically first N); 0 = all 54 weeks.
VED_WEEKS=2

# Simulator fault injection (fractions of trips) and RNG seed.
SIM_SEED=42
FAULT_DUPLICATE_RATE=0.02
FAULT_LATE_RATE=0.03
FAULT_PARTIAL_RATE=0.01
FAULT_SPEED_SPIKE_RATE=0.01

SPARK_DRIVER_MEMORY=2g
LOG_LEVEL=INFO
